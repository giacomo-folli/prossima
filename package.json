{
  "name": "prossima",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "packageManager": "pnpm@11.5.0",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "test:unit": "vitest run --coverage",
    "test:integration": "supabase test db",
    "test:e2e": "node scripts/test-browser.mjs --project=desktop-chromium --project=mobile-chromium --project=mobile-small",
    "test:a11y": "node scripts/test-browser.mjs --project=a11y-chromium",
    "test:browser": "node scripts/test-browser.mjs",
    "test:worker": "pnpm --dir groq-worker test",
    "test": "pnpm test:unit && pnpm test:worker && pnpm test:integration && pnpm test:browser",
    "test:ci": "pnpm check && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "pwacompat": "^2.0.17",
    "supabase": "^2.116.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@supabase/supabase-js": "^2.117.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@types/luxon": "^3.7.1",
    "@vite-pwa/sveltekit": "^1.1.0",
    "luxon": "^3.7.2",
    "posthog-js": "^1.376.0",
    "yaml": "^2.8.4"
  }
}
